# Copy to .streamlit/secrets.toml locally; use the Secrets editor on Community Cloud.
OPENAI_API_KEY = "replace-with-your-api-key"
OPENAI_VISION_MODEL = "gpt-4.1-mini"
OPENAI_SEARCH_MODEL = "gpt-4.1-mini"

# Local demo storage. Use an absolute path on durable storage for a single-host deployment.
COMMUNITY_DB_PATH = ".local/community.sqlite3"
COMMUNITY_ENABLED = true
